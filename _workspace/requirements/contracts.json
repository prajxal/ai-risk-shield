{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentic Commerce AI Risk Shield - Data Contracts",
  "version": "1.0.0",
  "definitions": {
    "AgentMetadata": {
      "type": "object",
      "properties": {
        "agent_id": { "type": "string" },
        "session_id": { "type": "string" },
        "ip_address": { "type": "string" },
        "retry_count": { "type": "integer", "default": 0 }
      },
      "required": ["agent_id", "session_id"]
    },
    "UserStatedIntent": {
      "type": "object",
      "properties": {
        "requested_items": { "type": "string" },
        "max_budget": { "type": "number" },
        "currency": { "type": "string", "default": "INR" },
        "constraints": { "type": "string" },
        "quantity": { "type": "integer", "default": 1 }
      },
      "required": ["requested_items", "max_budget"]
    },
    "CartItem": {
      "type": "object",
      "properties": {
        "sku": { "type": "string" },
        "title": { "type": "string" },
        "quantity": { "type": "integer" },
        "unit_price": { "type": "number" },
        "item_description": { "type": "string", "default": "" }
      },
      "required": ["sku", "title", "quantity", "unit_price"]
    },
    "CheckoutPayload": {
      "type": "object",
      "properties": {
        "cart_items": {
          "type": "array",
          "items": { "$ref": "#/definitions/CartItem" }
        },
        "total_amount": { "type": "number" },
        "currency": { "type": "string", "default": "INR" },
        "shipping_address": { "type": "string" }
      },
      "required": ["cart_items", "total_amount"]
    },
    "GroundTruth": {
      "type": "object",
      "properties": {
        "target_attack_class": {
          "type": ["string", "null"],
          "enum": ["PROMPT_INJECTION", "INTENT_MISMATCH", "PRICE_QUANTITY_ESCALATION", "VELOCITY_ABUSE", "BENIGN", null]
        },
        "expected_decision": {
          "type": "string",
          "enum": ["ALLOW", "FLAG", "BLOCK"]
        },
        "failure_case": { "type": "boolean", "default": false },
        "rationale": { "type": "string" }
      },
      "required": ["expected_decision", "rationale"]
    },
    "Transaction": {
      "type": "object",
      "properties": {
        "transaction_id": { "type": "string" },
        "is_synthetic": { "type": "boolean", "default": true },
        "split": { "type": "string", "enum": ["dev", "heldout_eval", "demo"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "agent_metadata": { "$ref": "#/definitions/AgentMetadata" },
        "user_stated_intent": { "$ref": "#/definitions/UserStatedIntent" },
        "checkout_payload": { "$ref": "#/definitions/CheckoutPayload" },
        "ground_truth": { "$ref": "#/definitions/GroundTruth" }
      },
      "required": ["transaction_id", "agent_metadata", "user_stated_intent", "checkout_payload"]
    },
    "ShieldDecision": {
      "type": "object",
      "properties": {
        "action": { "type": "string", "enum": ["ALLOW", "FLAG", "BLOCK"] },
        "reason": { "type": "string" },
        "triggered_checks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "risk_score": { "type": "number", "minimum": 0.0, "maximum": 100.0 }
      },
      "required": ["action", "reason", "triggered_checks", "confidence", "risk_score"]
    },
    "AuditEntry": {
      "type": "object",
      "properties": {
        "audit_id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "transaction_id": { "type": "string" },
        "agent_id": { "type": "string" },
        "session_id": { "type": "string" },
        "decision": { "type": "string", "enum": ["ALLOW", "FLAG", "BLOCK"] },
        "reason": { "type": "string" },
        "triggered_checks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "check_details": { "type": "object" }
      },
      "required": ["audit_id", "timestamp", "transaction_id", "agent_id", "session_id", "decision", "reason", "triggered_checks", "check_details"]
    },
    "EvaluationMetric": {
      "type": "object",
      "properties": {
        "precision": { "type": "number" },
        "recall": { "type": "number" },
        "false_positive_rate": { "type": "number" },
        "confusion_matrix": {
          "type": "object",
          "properties": {
            "tp": { "type": "integer" },
            "fp": { "type": "integer" },
            "tn": { "type": "integer" },
            "fn": { "type": "integer" }
          },
          "required": ["tp", "fp", "tn", "fn"]
        },
        "by_attack_class": { "type": "object" },
        "sample_count": { "type": "integer" }
      },
      "required": ["precision", "recall", "false_positive_rate", "confusion_matrix", "by_attack_class", "sample_count"]
    }
  }
}
