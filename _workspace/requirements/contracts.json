{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Return-Risk Shield - Data Contracts",
  "version": "2.0.0",
  "definitions": {
    "CustomerProfile": {
      "type": "object",
      "properties": {
        "customer_id": { "type": "string" },
        "account_age_days": { "type": "integer" },
        "total_orders_count": { "type": "integer" },
        "total_returns_count": { "type": "integer" },
        "historical_return_rate": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "past_return_reasons": { "type": "array", "items": { "type": "string" } },
        "dispute_chargeback_count": { "type": "integer", "default": 0 }
      },
      "required": ["customer_id", "account_age_days", "total_orders_count", "total_returns_count", "historical_return_rate"]
    },
    "OrderItem": {
      "type": "object",
      "properties": {
        "sku": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "unit_price": { "type": "number" },
        "discount_pct": { "type": "number", "default": 0.0 },
        "size_variant": { "type": ["string", "null"] },
        "color_variant": { "type": ["string", "null"] },
        "is_high_resale": { "type": "boolean", "default": false }
      },
      "required": ["sku", "title", "category", "unit_price"]
    },
    "OrderDetails": {
      "type": "object",
      "properties": {
        "order_id": { "type": "string" },
        "order_date": { "type": "string" },
        "days_since_purchase": { "type": "integer" },
        "total_order_amount": { "type": "number" },
        "currency": { "type": "string", "default": "INR" },
        "payment_method": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/definitions/OrderItem" } }
      },
      "required": ["order_id", "days_since_purchase", "total_order_amount", "payment_method", "items"]
    },
    "ReturnRequest": {
      "type": "object",
      "properties": {
        "return_id": { "type": "string" },
        "return_reason_code": { "type": "string" },
        "return_reason_notes": { "type": "string" },
        "returned_items": { "type": "array", "items": { "$ref": "#/definitions/OrderItem" } },
        "requested_refund_amount": { "type": "number" },
        "refund_destination": { "type": "string" },
        "item_condition_tag": { "type": ["string", "null"] }
      },
      "required": ["return_id", "return_reason_code", "returned_items", "requested_refund_amount"]
    },
    "ReturnEvent": {
      "type": "object",
      "properties": {
        "event_id": { "type": "string" },
        "is_synthetic": { "type": "boolean", "default": true },
        "split": { "type": "string", "enum": ["dev", "heldout_eval", "demo", "live"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "customer_profile": { "$ref": "#/definitions/CustomerProfile" },
        "order_details": { "$ref": "#/definitions/OrderDetails" },
        "return_request": { "$ref": "#/definitions/ReturnRequest" },
        "ground_truth": { "$ref": "#/definitions/GroundTruth" }
      },
      "required": ["event_id", "customer_profile", "order_details", "return_request"]
    },
    "ShieldDecision": {
      "type": "object",
      "properties": {
        "action": { "type": "string", "enum": ["ALLOW", "FLAG", "BLOCK"] },
        "reason": { "type": "string" },
        "triggered_checks": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "risk_score": { "type": "number", "minimum": 0.0, "maximum": 100.0 }
      },
      "required": ["action", "reason", "triggered_checks", "confidence", "risk_score"]
    },
    "AuditEntry": {
      "type": "object",
      "properties": {
        "audit_id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "event_id": { "type": "string" },
        "customer_id": { "type": "string" },
        "order_id": { "type": "string" },
        "return_id": { "type": "string" },
        "decision": { "type": "string", "enum": ["ALLOW", "FLAG", "BLOCK"] },
        "reason": { "type": "string" },
        "triggered_checks": { "type": "array", "items": { "type": "string" } },
        "check_details": { "type": "object" }
      },
      "required": ["audit_id", "timestamp", "event_id", "customer_id", "order_id", "return_id", "decision", "reason", "triggered_checks", "check_details"]
    }
  }
}
